---
import { getCollection } from "astro:content";

import ContactCTA from "../components/ContactCTA.astro";
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getBlogCategoryPath, getBlogPostPath } from "../constants";
import { getBlogFeaturedSrc, getBlogThumbSrc } from "../utils/blogImages";

const published = await getCollection("blog", ({ data }) => !data.draft);
const sorted = published.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);
const featured =
  sorted.find((p) => p.data.featured) ?? sorted[0] ?? null;
const rest = featured
  ? sorted.filter((p) => p !== featured).slice(0, 4)
  : sorted.slice(0, 4);

function formatDate(d: Date) {
  return d.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}

const categoryLabels = [
  ...new Set(sorted.map((p) => p.data.category)),
].sort();
const categories = categoryLabels.map((label) => ({
  label,
  href: getBlogCategoryPath(label),
}));
---

<BaseLayout
  title="Blog | Behind the Action Photography"
  description="Notes on toy photography, lighting, and collecting."
>
  <div class="stack gap-20">
    <main class="wrapper blog-page">
      <Hero
        title="The POV Blog"
        tagline="The Point of View Blog is a collection of short reads on photo shoots, figures, and my journey as a photographer."
        align="start"
      />

      <div class="blog-shell">
        <div class="blog-main">
          <div class="section-label">
            <span class="section-label__line" aria-hidden="true"></span>
            <h2 class="section-label__text">Featured stories</h2>
          </div>

          {
            featured && (
              <article class="featured-card">
                <a
                  class="featured-card__media"
                  href={getBlogPostPath(
                    featured.data.category,
                    featured.data.slug
                  )}
                >
                  <img
                    class="thumb thumb--featured"
                    src={getBlogFeaturedSrc(featured.data)}
                    alt={featured.data.img_alt ?? ""}
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                    width="1200"
                    height="900"
                  />
                </a>
                <div class="featured-card__body">
                  <p class="meta">
                    <time datetime={featured.data.publishDate.toISOString()}>
                      {formatDate(featured.data.publishDate)}
                    </time>
                    <span class="meta__sep">·</span>
                    <span>{featured.data.category}</span>
                  </p>
                  <h3 class="featured-card__title">
                    <a
                      href={getBlogPostPath(
                        featured.data.category,
                        featured.data.slug
                      )}
                    >
                      {featured.data.title}
                    </a>
                  </h3>
                  <p class="featured-card__excerpt">
                    {featured.data.description}
                  </p>
                </div>
              </article>
            )
          }

          <div class="post-grid">
            {
              rest.map((post) => (
                <article class="post-card">
                  <a
                    class="post-card__media"
                    href={getBlogPostPath(post.data.category, post.data.slug)}
                  >
                    <img
                      class="thumb"
                      src={getBlogThumbSrc(post.data)}
                      alt={post.data.img_alt ?? ""}
                      loading="lazy"
                      decoding="async"
                      width="800"
                      height="500"
                    />
                  </a>
                  <div class="post-card__body">
                    <p class="meta">
                      <time datetime={post.data.publishDate.toISOString()}>
                        {formatDate(post.data.publishDate)}
                      </time>
                      <span class="meta__sep">·</span>
                      <span>{post.data.category}</span>
                    </p>
                    <h3 class="post-card__title">
                      <a
                        href={getBlogPostPath(
                          post.data.category,
                          post.data.slug
                        )}
                      >
                        {post.data.title}
                      </a>
                    </h3>
                    <p class="post-card__excerpt">{post.data.description}</p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>

        <aside class="blog-sidebar" aria-labelledby="categories-heading">
          <div class="categories-card">
            <h2 class="categories-card__title" id="categories-heading">
              Categories
            </h2>
            <ul class="categories-card__list">
              {
                categories.map(({ href, label }) => (
                  <li>
                    <a href={href}>{label}</a>
                  </li>
                ))
              }
            </ul>
          </div>
        </aside>
      </div>
    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .blog-page {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .blog-shell {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .blog-main {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .section-label__line {
    flex: 1;
    height: 1px;
    background: var(--gray-800);
    min-width: 2rem;
  }

  .section-label__text {
    font-family: var(--font-brand);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gray-100);
    margin: 0;
    white-space: nowrap;
  }

  .featured-card {
    display: grid;
    gap: 1.25rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--gray-800);
  }

  .featured-card__media {
    display: block;
    border-radius: 0.75rem;
    overflow: hidden;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
  }

  .thumb {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--gradient-subtle);
    border: 1px solid var(--gray-800);
    transition: box-shadow var(--theme-transition);
  }

  .thumb--featured {
    aspect-ratio: 16 / 10;
    min-height: 12rem;
  }

  .featured-card__media:hover .thumb,
  .post-card__media:hover .thumb {
    box-shadow: var(--shadow-md);
  }

  .featured-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    color: var(--gray-200);
  }

  .meta {
    margin: 0;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--gray-400);
    font-weight: 500;
  }

  .meta__sep {
    margin-inline: 0.35rem;
    opacity: 0.7;
  }

  .featured-card__title {
    margin: 0;
    font-size: var(--text-2xl);
    line-height: 1.15;
    font-family: var(--font-brand);
    font-weight: 600;
    color: var(--gray-100);
  }

  .featured-card__title a,
  .post-card__title a {
    color: inherit;
    text-decoration: none;
    transition: color var(--theme-transition);
  }

  .featured-card__title a:hover,
  .post-card__title a:hover {
    color: var(--accent-regular);
  }

  .featured-card__excerpt {
    margin: 0;
    font-size: var(--text-md);
    line-height: 1.55;
    max-width: 55ch;
  }

  .post-grid {
    display: grid;
    gap: 2rem;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--gray-800);
  }

  .post-card:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .post-card__media {
    display: block;
    border-radius: 0.75rem;
    overflow: hidden;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
  }

  .post-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--gray-200);
  }

  .post-card__title {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.2;
    font-family: var(--font-brand);
    font-weight: 600;
    color: var(--gray-100);
  }

  .post-card__excerpt {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--gray-300);
  }

  .blog-sidebar {
    flex-shrink: 0;
  }

  .categories-card {
    padding: 1.25rem 1.5rem;
    background: var(--gradient-subtle);
    border: 1px solid var(--gray-800);
    border-radius: 0.75rem;
    box-shadow: var(--shadow-sm);
  }

  .categories-card__title {
    margin: 0 0 0.75rem;
    font-family: var(--font-brand);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--gray-100);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--gray-800);
  }

  .categories-card__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .categories-card__list a {
    color: var(--gray-200);
    text-decoration: none;
    font-size: var(--text-md);
    transition: color var(--theme-transition);
  }

  .categories-card__list a:hover {
    color: var(--accent-regular);
  }

  @media (min-width: 50em) {
    .blog-shell {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(14rem, 18rem);
      gap: 3rem;
      align-items: start;
    }

    .featured-card {
      grid-template-columns: 1.1fr 1fr;
      gap: 2rem;
      align-items: start;
    }

    .thumb--featured {
      min-height: 14rem;
      aspect-ratio: 4 / 3;
    }

    .post-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 2.5rem;
      column-gap: 2.5rem;
      row-gap: 2.5rem;
    }

    .post-card {
      border-bottom: none;
      padding-bottom: 0;
    }

    .blog-sidebar {
      position: sticky;
      top: 2rem;
    }
  }
</style>
