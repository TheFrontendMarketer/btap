---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Thanks | Behind the Action Photography"
	description="Your message was sent successfully."
>
	<main class="wrapper success-page">
		<div class="success-card">
			<h1 class="success-title">Submission received!</h1>
			<p class="success-body">
				Thank you for your interest. Head back to the{" "}
				<a href="/">home page</a> or{" "}
				<a href="/contact/">send another message</a>.
			</p>
		</div>
	</main>
</BaseLayout>

<style>
	.success-page {
		padding-block: 3rem 6rem;
		min-height: 50vh;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.success-card {
		max-width: 42rem;
		margin-inline: auto;
		padding: 2.5rem 1.75rem;
		text-align: center;
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
		box-shadow: var(--shadow-sm);
	}

	.success-title {
		margin: 0 0 1.25rem;
		font-family: var(--font-brand);
		font-size: var(--text-3xl);
		font-weight: 600;
		line-height: 1.1;
		color: var(--accent-regular);
	}

	@supports ((-webkit-background-clip: text) or (background-clip: text)) {
		.success-title {
			background: var(--gradient-accent-orange);
			-webkit-background-clip: text;
			background-clip: text;
			color: transparent;
		}
	}

	.success-body {
		margin: 0;
		font-family: var(--font-body);
		font-size: var(--text-lg);
		line-height: 1.6;
		color: var(--gray-200);
	}

	.success-body a {
		color: var(--link-color);
		font-weight: 600;
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.2em;
		transition: text-decoration-color var(--theme-transition);
	}

	.success-body a:hover,
	.success-body a:focus {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.success-page {
			padding-block: 4rem 8rem;
		}

		.success-card {
			padding: 3rem 2.5rem;
			border-radius: 1.25rem;
		}

		.success-title {
			font-size: var(--text-4xl);
		}

		.success-body {
			font-size: var(--text-xl);
		}
	}
</style>
